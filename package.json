{
  "name": "work-activation-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/*.test.ts && node --test prototype/app.test.mjs && node --test noteplan-plugin/script.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "@google-cloud/secret-manager": "^6.1.0",
    "googleapis": "^159.0.0",
    "openai": "^5.20.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
